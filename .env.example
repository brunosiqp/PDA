# Exemplo de configuração por variáveis de ambiente (monitor do EmailPack).
# O resto das credenciais fica em CREDENCIAIS_CENTRALIZADAS.env (formato INI, uma seção por
# integração), nos .env.<nome> legados e no config.dat cifrado. Tudo fora do git.
# Use SEMPRE valores do seu ambiente; nunca commite valores reais.

# Compartilhamento de rede com os logs do EmailPack
EMAILPACK_UNC_SERVIDOR=\\servidor-emailpack\EmailPack
# Pastas de log separadas por ";" (substitui o padrão derivado do servidor)
EMAILPACK_DIRS=
EMAILPACK_UNC_USUARIO=
# Prefira guardar a senha do compartilhamento e o webhook do Teams em
# "Configurações Seguras" (cifrado) em vez de aqui.
EMAILPACK_UNC_SENHA=
EMAILPACK_TEAMS_WEBHOOK=

# Ajustes finos (opcionais)
EMAILPACK_INTERVALO_SEG=
EMAILPACK_DEDUP_MIN=
EMAILPACK_HEARTBEAT=
EMAILPACK_TIMEOUT_DIR=
EMAILPACK_LOG_ENCODING=
EMAILPACK_IDENTIFICACAO=
