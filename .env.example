# Exemplo de configuração por variáveis de ambiente.
# Defina estas variáveis no ambiente do processo (o app lê via os.environ). Use SEMPRE valores
# do seu ambiente; nunca commite valores reais.

# --- Primeiro acesso ---------------------------------------------------------
# Senha do usuário "admin" criado na primeira execução. Se ficar vazia, uma senha
# aleatória é sorteada e registrada UMA vez no log.
PDA_ADMIN_SENHA_INICIAL=
# Senha inicial dos cadastros novos (Manutenção de Usuários). Obrigatória para
# cadastrar usuários e enviar e-mail de boas-vindas.
PDA_SENHA_PADRAO_NOVOS_USUARIOS=

# --- Servidor web ------------------------------------------------------------
PDA_LINK_WEB=http://localhost:8765/
# Nome amigável exibido no lugar do nome da máquina (opcional).
PDA_NOME_AMIGAVEL_WEB=

# --- Destinatários de e-mail (separados por vírgula; vazio = ninguém) ---------
PDA_DESTINATARIOS_TEMPO_EMPRESA=
PDA_DESTINATARIOS_FEEDBACK_EXTRAS=
PDA_EMAIL_MONITORAMENTO=monitoramento@example.com

# --- Caminhos e servidores de rede -------------------------------------------
PDA_FTP_UNC=\\servidor-ftp\FTP
PDA_DASH_FINANCEIRO_PASTA=C:\PDA\PowerBI\Financeiro
PDA_LOGS_MONITORAMENTO=C:\PDA\Monitoramento\log

# --- Monitoramento EmailPack -------------------------------------------------
EMAILPACK_UNC_SERVIDOR=\\servidor-emailpack\EmailPack
# Lista de pastas de log separadas por ";" (substitui o padrão derivado do servidor).
EMAILPACK_DIRS=
EMAILPACK_UNC_USUARIO=
# Prefira guardar a senha do compartilhamento e o webhook do Teams em
# "Configurações Seguras" (cifrado) em vez de aqui.
EMAILPACK_UNC_SENHA=
EMAILPACK_TEAMS_WEBHOOK=

# --- Identificadores de cliente (nunca no código) ------------------------------
# CNPJ usado pelo dashboard nativo do "ClienteB" (só dígitos).
PDA_CNPJ_NFAG_CLIENTE_B=
# CNPJ excluído da lista "Nao Especificado" do consolidado de NFSe Out.
PDA_CNPJ_EXCLUIDO_NFSE_OUT=
# Caminho do arquivo de aliases privados (padrão: aliases_privados.json ao lado do programa).
PDA_ALIASES_PRIVADOS=

# --- Card externo do hub -----------------------------------------------------
PDA_URL_MEU_PLANTAO=#
